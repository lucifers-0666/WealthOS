# WealthOS Node API — copy values from your ROOT .env
# This file reads the shared root .env automatically via dotenv.
# Just update the path below if your folder structure differs.

# Run: node -e "require('dotenv').config({ path: '../.env' }); console.log('ok')"
# to verify the root .env is found.

# ─── Override only if different from root .env ───────────────
PORT=4000
NODE_ENV=development

# These are loaded from ROOT .env (../.env) automatically.
# You do NOT need to duplicate SUPABASE_URL, OPENAI_API_KEY, etc.
# See server.js — it loads '../.env' first, then '.env' as override.
