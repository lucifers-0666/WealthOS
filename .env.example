# ============================================
# WealthOS Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

# Google Gemini API Key (for AI CFO)
# Get from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini models used by the advisor and image-recognition OCR
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# ── Supabase (PostgreSQL) ──────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key — NEVER expose in frontend, backend only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── NewsAPI ───────────────────────────────
# Get from: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# ── Alpha Vantage (backup price data) ─────
# Get from: https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ── HuggingFace Token ─────────────────────
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ── App Settings ──────────────────────────
APP_NAME=WealthOS
DEBUG=False
DEFAULT_CURRENCY=INR
DEFAULT_EXCHANGE=NSE

# ── Frontend API routing ──────────────────
# Keep blank when using Vite proxy. Set only for separate deployments.
VITE_API_BASE_URL=
