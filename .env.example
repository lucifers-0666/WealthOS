# WealthOS backend/shared environment template
# Copy this file to WealthOS/.env and keep the real values local only.

# ── Supabase (required) ──────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / market integrations ─────────────────────────
GOOGLE_API_KEY=
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=
TWELVE_DATA_KEY=
FINNHUB_KEY=

# ── Runtime configuration ────────────────────────────
DATABASE_URL=
SECRET_KEY=
FRONTEND_URL=http://localhost:3001,http://127.0.0.1:3001
DEV_USER_ID=dev-user-123

# ── Optional tuning ──────────────────────────────────
DEFAULT_CURRENCY=INR
DEFAULT_EXCHANGE=NSE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2000
GEMINI_TEMPERATURE=0.7
GEMINI_VISION_MODEL=gemini-2.5-flash
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
NEWS_LOOKBACK_DAYS=7
NEWS_MAX_ARTICLES=20
