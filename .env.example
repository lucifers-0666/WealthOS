# WealthOS — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Market Data Providers ──────────────────────────────────────────────────────
# Finnhub (primary): https://finnhub.io/
FINNHUB_API_KEY=your-finnhub-key-here

# Yahoo Finance (fallback) — no key required, uses public API
# YAHOO_FINANCE_ENABLED=true

# NSE India (tertiary fallback) — public, no key required
# NSE_FALLBACK_ENABLED=true

# ── Backend Server ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins for production
# In development, * is used automatically
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3001

# ── Frontend ───────────────────────────────────────────────────────────────────
# Vite env vars must be prefixed with VITE_
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/market

# Production overrides
# VITE_API_URL=https://your-backend.railway.app
# VITE_WS_URL=wss://your-backend.railway.app/ws/market

# ── Optional Observability ─────────────────────────────────────────────────────
# Sentry DSN (leave empty to disable)
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── Application ────────────────────────────────────────────────────────────────
ENV=development
# ENV=production

# JWT secret for session tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-this-to-a-random-64-char-string

# Cache TTL in seconds (default: 30)
CACHE_TTL=30

# Market poll interval in seconds (default: 15)
MARKET_POLL_INTERVAL=15
