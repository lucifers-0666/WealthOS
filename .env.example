# ============================================================
# WealthOS — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ── Supabase (PostgreSQL + Auth + Storage) ──────────────────
# Get from: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase Direct DB Connection (for migrations) ──────────
# Get from: Supabase Dashboard → Settings → Database → Connection String → URI
SUPABASE_DB_URL=postgresql://postgres:<your-password>@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── AI Models ───────────────────────────────────────────────
# Google Gemini (CFO Advisor): https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# ── News (RAG Pipeline) ─────────────────────────────────────
# NewsAPI: https://newsapi.org/register (free: 100 requests/day)
NEWSAPI_KEY=your_newsapi_key_here

# ── Price Data ───────────────────────────────────────────────
# Alpha Vantage fallback (free: 25 requests/day): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ── Dev Settings ─────────────────────────────────────────────
# Set your Supabase user UUID here for local dev (bypasses JWT auth)
DEV_USER_ID=your-supabase-user-uuid-here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
