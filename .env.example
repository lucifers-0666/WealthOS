# WealthOS Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Get from: https://supabase.com → Project → Settings → Database → Connection string
# Use the "Transaction pooler" URL for FastAPI (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Supabase (Auth + Client SDK) ───────────────────────────────────────────
# Get from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Redis Cache (Upstash — free tier) ──────────────────────────────────────
# Get from: https://upstash.com → Create Redis → Copy REST URL
# Leave blank to use in-memory fallback (no Redis needed for local dev)
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

# ── AI / LLM ────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key

# ── News / RAG ────────────────────────────────────────────────────────────
# Get from: https://newsapi.org/register (free 100 req/day)
NEWSAPI_KEY=your_newsapi_key

# ── Market Data ─────────────────────────────────────────────────────────
# Get from: https://www.alphavantage.co/support/#api-key (free)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# ── Frontend config ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Dev / Testing ─────────────────────────────────────────────────────────
# Set this to skip JWT verification in local dev
# Remove entirely in production
DEV_USER_ID=your_supabase_user_uuid_here
