# ══════════════════════════════════════════════════════
# WealthOS — Environment Variables
# Copy this file to .env and fill in your keys
# ══════════════════════════════════════════════════════

# ── AI Advisor (Gemini) ──────────────────────────────
# Get free key: https://aistudio.google.com
GOOGLE_API_KEY=

# ── Market News (NewsAPI) ────────────────────────────
# Get free key: https://newsapi.org (free = 100 req/day)
NEWSAPI_KEY=

# ── Alpha Vantage (backup price data, optional) ──────
# Get free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=
